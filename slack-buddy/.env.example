# Slack account authorized by the approved MCP connector:
SLACK_USER_ID="U0123456789"
# Server-side credential for Mistral model calls and the Slack MCP gateway:
MISTRAL_API_KEY="your-mistral-api-key"
# Generate a separate owner access key with: openssl rand -hex 32
SLACK_BUDDY_WEB_SECRET=""
# Only for local Wrangler development, so cookies work on http://localhost:
SLACK_BUDDY_LOCAL_DEV="true"

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slack-buddy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SLACK_BUDDY_TIMEZONE": "Europe/Paris",
    "SLACK_BUDDY_DIGEST_HOUR": "8",
    "SLACK_BUDDY_AUTO_JOIN_PUBLIC_CHANNELS": "true",
    "SLACK_BUDDY_RETENTION_DAYS": "14",
    "SLACK_BUDDY_RECONCILE_HOURS": "48",
    "SLACK_BUDDY_DIRECTORY_REFRESH_HOURS": "24",
    "SLACK_BUDDY_FULL_SCAN_DAYS": "7",
    "SLACK_BUDDY_JOB_PHASES": "10",
    "MISTRAL_MODEL": "zai-glm-5-2",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slack-buddy-db",
      "database_id": "94332229-9de9-4e16-b8c2-7669b9f2118e",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SLACK_BUDDY_AGENT",
        "class_name": "SlackBuddyAgent",
      },
      {
        "name": "CHAT_STATE",
        "class_name": "ChatStateDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SlackBuddyAgent", "ChatStateDO"],
    },
  ],
  "workflows": [
    {
      "name": "slack-buddy-digest",
      "binding": "DIGEST_WORKFLOW",
      "class_name": "SlackBuddyDigestWorkflow",
    },
  ],
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "limits": { "cpu_ms": 30000, "subrequests": 10000 },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
}

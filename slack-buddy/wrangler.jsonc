{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slack-buddy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SLACK_BUDDY_SCHEDULED_MCP_ENABLED": "false",
    "MISTRAL_MODEL": "zai-glm-5-2",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slack-buddy-db",
      "database_id": "2ed53116-12cc-4ff9-a245-62ec7b3ff152",
      "migrations_dir": "migrations",
    },
  ],
  // Deployment history only. The MCP app has no Durable Object bindings.
  // v2 retires these namespaces and deletes their stored data on deployment.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SlackBuddyAgent", "ChatStateDO"],
    },
    {
      "tag": "v2-mcp-only",
      "deleted_classes": ["SlackBuddyAgent", "ChatStateDO"],
    },
  ],
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "limits": { "cpu_ms": 30000, "subrequests": 10000 },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
}

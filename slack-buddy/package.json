{
  "name": "@buddy/slack-buddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A DevRel Slack agent that watches joined channels and briefs its owner daily.",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@types/node": "^26.6.0",
    "typescript": "^5.5.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.132.0"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.49",
    "@cloudflare/think": "^0.18.0",
    "agents": "^0.23.0",
    "ai": "^7.0.93",
    "zod": "^4.6.5"
  }
}

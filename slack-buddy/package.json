{
  "name": "@buddy/slack-buddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A private DevRel briefing and research app using the Mistral Slack MCP connector.",
  "scripts": {
    "dev": "wrangler dev --env-file .env",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply slack-buddy-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply slack-buddy-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../.prettierignore --check .",
    "check": "npm run typecheck && npm test",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@ai-sdk/mistral": "4.0.39",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ai": "7.0.93",
    "jose": "6.2.12",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260905.1",
    "@types/node": "26.4.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "wrangler": "4.129.0"
  },
  "engines": {
    "node": ">=22"
  }
}
